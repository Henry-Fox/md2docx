{
  "name": "md2docx",
  "version": "1.6.8",
  "description": "A browser-based Markdown to Word DOCX and PDF converter with true WYSIWYG preview, templates, and Word format import.",
  "main": "index.js",
  "private": true,
  "keywords": [
    "markdown",
    "docx",
    "pdf",
    "word",
    "markdown-to-word",
    "markdown-to-docx",
    "markdown-to-pdf",
    "template",
    "converter"
  ],
  "license": "MIT",
  "author": "Henry Fox",
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "webpack serve --open --config webpack.config.dev.js",
    "build": "webpack --config webpack.config.prod.js",
    "prepare-release": "node scripts/prepare-release.js",
    "release": "npm run prepare-release && cd release && zip -r ../md2docx-v1.6.3.zip ."
  },
  "devDependencies": {
    "@vitest/ui": "^5.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^29.1.1",
    "vitest": "^5.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.5.0",
    "file-saver": "^2.0.5",
    "i18next": "^25.2.1",
    "marked": "^15.0.11",
    "marked-extended-tables": "^2.0.1",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-mangle": "^1.1.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react-i18next": "^15.5.2"
  }
}
